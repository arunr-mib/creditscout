# Copy to .env and fill the blanks. .env is gitignored.

# ---- Supabase (project rngsejqplndmygrozasc, ca-central-1) ----
SUPABASE_URL=https://rngsejqplndmygrozasc.supabase.co
# Dashboard > Settings > API > service_role. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (not used by the app; kept for local tooling) ----
ANTHROPIC_API_KEY=

# ---- Azure AI Foundry ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=AI_Learning
AZURE_AI_ACCOUNT=contractreviewagent-resource
AZURE_AI_PROJECT_NAME=creditscout
AZURE_AI_PROJECT_ENDPOINT=https://contractreviewagent-resource.services.ai.azure.com/api/projects/creditscout
AZURE_OPENAI_ENDPOINT=https://contractreviewagent-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Deployments live on the account. Embeddings are 1536-dimensional.
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_JUDGE_DEPLOYMENT=gpt-4.1-mini

# ---- Browser-side (safe to expose; anon key is read-only under RLS) ----
NEXT_PUBLIC_SUPABASE_URL=https://rngsejqplndmygrozasc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Foundry Agent Service ----
# Orchestrator MUST be a model that supports connected_agent tools.
# gpt-5-mini does NOT (Assistants API rejects it); gpt-4.1-mini does.
FOUNDRY_ORCHESTRATOR_MODEL=gpt-4.1-mini
FOUNDRY_SPECIALIST_MODEL=gpt-5-mini
FOUNDRY_API_VERSION=2025-05-01

# Shared secret the Foundry agent sends on every /api/tools/* call, as the
# X-CreditScout-Tool-Key header. Generate it (never commit the value):
#   openssl rand -hex 32
# The tool routes FAIL CLOSED: if this is unset, empty or shorter than 32
# characters, every request is rejected with 401.
CREDITSCOUT_TOOL_KEY=

# Public URL the Foundry agent calls; becomes servers[0].url in the OpenAPI
# document at /api/tools/openapi. Defaults to http://localhost:3000 when unset.
PUBLIC_BASE_URL=

# Vercel Protection Bypass for Automation secret. Set ONLY when the deployment
# has Deployment Protection (password/SSO) enabled, so the server's self-calls to
# its own /api/tools/* and /api/investigate/sync routes get past the protection
# gate. Leave unset for a public deploy or local dev. (Generated by Vercel when
# you enable Protection Bypass for Automation.)
VERCEL_AUTOMATION_BYPASS_SECRET=

# Azure service principal for Foundry auth on a DEPLOYMENT (Vercel has no az CLI).
# When all three are set, the agent takes a client-credentials token instead of
# the local `az login` credential. Leave UNSET locally (the CLI is used). The SP
# must have a role on the AI Foundry project (e.g. Azure AI Developer).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Optional on a deploy: the orchestrator agent id, so the app never depends on
# lib/agent/agents.json being in the serverless bundle. Value is agents.json's
# agents.creditscout_orchestrator. Leave unset locally (the file is read).
FOUNDRY_ORCHESTRATOR_AGENT_ID=

# Demo access gate (shared credential for the deployed demo; not multi-user auth)
DEMO_USERNAME=analyst
DEMO_PASSWORD=change-me-in-the-deploy
